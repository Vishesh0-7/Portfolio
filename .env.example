# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or any file containing real secrets.

# GitHub username whose repositories power the Projects section.
GITHUB_USERNAME=your-github-username

# Optional: a GitHub personal access token (fine-grained, read-only,
# "Public Repositories" scope is enough) to raise the unauthenticated
# API rate limit. Leave blank to use the public rate limit instead.
GITHUB_TOKEN=

# Optional: your deployed site's canonical URL, used for OpenGraph/Twitter
# metadata and the generated sitemap.xml / robots.txt. Defaults to
# http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
